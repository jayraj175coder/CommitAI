# ==============================================================================
# CommitAI - Environment Variables Template
# Provide real values in your Vercel Project Settings or local .env.local
# Never commit real secrets or credentials to source control.
# ==============================================================================

# Application Base URL (e.g. https://your-project.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Google OAuth Credentials (for Gmail & Google Calendar API access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Discord OAuth Credentials (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Telegram Bot Token (optional)
TELEGRAM_BOT_TOKEN=

# AI Provider API Key (optional - built-in deterministic engine is used if omitted)
OPENAI_API_KEY=


